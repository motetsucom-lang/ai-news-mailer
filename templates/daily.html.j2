<!DOCTYPE html>
<html lang="ja">
<head><meta charset="UTF-8"></head>
<body style="margin:0;padding:0;font-family:Hiragino Sans,sans-serif;background:#f4f4f4;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:20px 0;">
<tr><td align="center">
<table width="640" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:8px;overflow:hidden;max-width:640px;width:100%;">
<tr><td style="background:linear-gradient(135deg,#6a11cb 0%,#2575fc 100%);padding:30px 40px;text-align:center;">
<h1 style="color:#fff;margin:0;font-size:24px;">AI News</h1>
<p style="color:#e0e0ff;margin:8px 0 0;font-size:14px;">{{ date }}</p>
</td></tr>
<tr><td style="padding:30px 40px;">
{% for source in sources %}
<h2 style="color:#2575fc;border-bottom:2px solid #f0f0f0;padding-bottom:8px;font-size:18px;margin-top:24px;">{{ source.name }}</h2>
<ul style="padding-left:20px;">
{% for entry in source.entries %}
<li style="margin-bottom:12px;line-height:1.6;">
<a href="{{ entry.link }}" style="color:#333;text-decoration:none;font-weight:bold;">{{ entry.title }}</a><br>
<span style="color:#888;font-size:12px;">{{ entry.published }}</span>
{% if entry.summary_jp %}
<br><span style="color:#555;font-size:13px;display:block;margin-top:4px;">{{ entry.summary_jp }}</span>
{% endif %}
</li>
{% endfor %}
</ul>
<hr style="border:none;border-top:1px solid #eee;margin:20px 0;">
{% endfor %}
<p style="color:#aaa;font-size:12px;text-align:right;">AI News Digest</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>